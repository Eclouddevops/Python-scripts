# Example variable overrides — copy to terraform.tfvars and edit as needed.

aws_region = "ap-south-1"

# Keep false when your AWS profile already resolves to the target account
# (e.g. AWS_PROFILE=CoreProdWorkloadAccount). Set true only to assume the role
# from a different base account.
enable_assume_role = false
assume_role_arn    = "arn:aws:iam::986788162487:role/OrganizationAccountAccessRole"

project_name  = "ubuntu-base"
environment   = "prod"
instance_type = "t3.large"

# Fixed public IP that survives restarts / instance replacement (recommended for FTP).
enable_elastic_ip = true

# IMPORTANT: lock this down to your office/VPN IP in production, e.g. ["203.0.113.10/32"]
allowed_ssh_cidrs = ["0.0.0.0/0"]

sftp_username   = "sftpuser"
sftp_upload_dir = "upload"

# --- Dedicated FTP storage volume (100 GiB by default) ---
ftp_data_volume_size = 100
ftp_data_volume_type = "gp3"
ftp_data_mount_point = "/srv/ftp"

# --- External password-based FTP user (give these creds to external users) ---
vsftp_username   = "vsftpuser"
vsftp_upload_dir = "files"
# Leave empty to auto-generate a strong password (stored in Secrets Manager).
vsftp_password = ""

# --- Web dashboard (browser-based file access via File Browser) ---
enable_web_dashboard     = true
web_dashboard_port       = 8080
web_dashboard_admin_user = "admin"
# Leave empty to auto-generate a strong password (stored in Secrets Manager).
web_dashboard_admin_password = ""
# IMPORTANT: restrict this to your IP in production, e.g. ["203.0.113.10/32"]
allowed_web_cidrs = ["0.0.0.0/0"]

# --- Web hosting (serve uploaded files over HTTP via nginx) ---
enable_web_hosting = true
web_hosting_subdir = "testwebsite"   # sub-folder of /srv/ftp/data to serve; "" = whole folder
web_hosting_port   = 80
